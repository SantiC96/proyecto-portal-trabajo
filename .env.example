NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Project ref de Supabase, solo para `npm run db:tipos` (no se usa en la app).
SUPABASE_PROJECT_ID=
# Envío de emails por SMTP (Gmail: smtp.gmail.com, puerto 465, contraseña de aplicación).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Remitente, por ejemplo: Portal de Empleo Funes <cuenta@gmail.com>
EMAIL_FROM=
# Secreto del cron de /api/emails/procesar. Vercel lo manda como "Authorization: Bearer <valor>".
CRON_SECRET=
# Datos de ejemplo en las pantallas de indicadores (oficina y empresa), para presentaciones.
# Con "true" muestran un año de uso ficticio, sin ninguna marca en pantalla: apagarla después de
# cada presentación. Sin la variable, los datos reales.
# No toca la base ni manda correos. En Vercel, después de cambiarla hay que volver a desplegar.
# INDICADORES_DE_EJEMPLO=true
